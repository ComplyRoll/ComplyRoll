{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "fullName": "Trivy Vulnerability Scanner",
          "informationUri": "https://example.test/trivy",
          "name": "Trivy",
          "rules": [
            {
              "id": "CVE-2099-0001",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "libexample-net: synthetic flaw for KEV tests"
              },
              "fullDescription": {
                "text": "SYNTHETIC. libexample-net before 4.2.1 has an invented flaw used only by the ComplyRoll KEV tests (R8)."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "helpUri": "https://example.test/advisories/cve-2099-0001",
              "help": {
                "text": "Vulnerability CVE-2099-0001\nSeverity: CRITICAL\nPackage: libexample-net\nFixed Version: 4.2.1\nLink: [CVE-2099-0001](https://example.test/advisories/cve-2099-0001)"
              },
              "properties": {
                "precision": "very-high",
                "tags": [
                  "vulnerability",
                  "security",
                  "CRITICAL"
                ]
              }
            }
          ],
          "version": "0.55.2"
        }
      },
      "automationDetails": {
        "id": "images/worker/run-7"
      },
      "invocations": [
        {
          "executionSuccessful": true,
          "startTimeUtc": "2026-09-02T10:15:00Z",
          "endTimeUtc": "2026-09-02T10:16:30Z"
        }
      ],
      "results": [
        {
          "ruleId": "CVE-2099-0001",
          "ruleIndex": 0,
          "level": "error",
          "message": {
            "text": "Package: libexample-net\nInstalled Version: 4.2.0\nVulnerability CVE-2099-0001\nSeverity: CRITICAL\nFixed Version: 4.2.1\nLink: [CVE-2099-0001](https://example.test/advisories/cve-2099-0001)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "usr/lib/libexample-net.so.4",
                  "uriBaseId": "ROOTPATH"
                },
                "region": {
                  "startLine": 1,
                  "startColumn": 1,
                  "endLine": 1,
                  "endColumn": 1
                }
              },
              "message": {
                "text": "usr/lib/libexample-net.so.4: libexample-net@4.2.0"
              }
            }
          ]
        }
      ],
      "columnKind": "utf16CodeUnits",
      "originalUriBaseIds": {
        "ROOTPATH": {
          "uri": "file:///"
        }
      },
      "properties": {
        "imageName": "registry.example.test/kev/worker:2.3.1",
        "repoTags": [
          "registry.example.test/kev/worker:2.3.1"
        ]
      }
    }
  ]
