{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "fullName": "Trivy Vulnerability Scanner",
          "informationUri": "https://github.com/aquasecurity/trivy",
          "name": "Trivy",
          "rules": [
            {
              "id": "CVE-2024-0001",
              "name": "LanguageSpecificPackageVulnerability",
              "shortDescription": {
                "text": "requests: header leak on cross-origin redirect"
              },
              "fullDescription": {
                "text": "Requests before 2.32.0 forwards the Authorization header to a different origin after a redirect."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2024-0001",
              "help": {
                "text": "Vulnerability CVE-2024-0001\nSeverity: CRITICAL\nPackage: requests\nFixed Version: 2.32.0\nLink: [CVE-2024-0001](https://avd.aquasec.com/nvd/cve-2024-0001)",
                "markdown": "**Vulnerability CVE-2024-0001**\n| Severity | Package | Fixed Version | Link |\n| --- | --- | --- | --- |\n|CRITICAL|requests|2.32.0|[CVE-2024-0001](https://avd.aquasec.com/nvd/cve-2024-0001)|\n"
              },
              "properties": {
                "precision": "very-high",
                "security-severity": "9.8",
                "tags": [
                  "vulnerability",
                  "security",
                  "CRITICAL"
                ]
              }
            },
            {
              "id": "CVE-2024-0002",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "musl: out-of-bounds read in wcsnrtombs"
              },
              "fullDescription": {
                "text": "musl libc before 1.2.5 mishandles a destination buffer length in wcsnrtombs."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2024-0002",
              "help": {
                "text": "Vulnerability CVE-2024-0002\nSeverity: MEDIUM\nPackage: musl\nFixed Version: 1.2.5-r0\nLink: [CVE-2024-0002](https://avd.aquasec.com/nvd/cve-2024-0002)",
                "markdown": "**Vulnerability CVE-2024-0002**\n| Severity | Package | Fixed Version | Link |\n| --- | --- | --- | --- |\n|MEDIUM|musl|1.2.5-r0|[CVE-2024-0002](https://avd.aquasec.com/nvd/cve-2024-0002)|\n"
              },
              "properties": {
                "precision": "very-high",
                "security-severity": "5.5",
                "tags": [
                  "vulnerability",
                  "security",
                  "MEDIUM"
                ]
              }
            }
          ],
          "version": "0.55.2"
        }
      },
